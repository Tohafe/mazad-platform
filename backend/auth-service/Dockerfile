# Build stage
FROM maven:3.9-amazoncorretto-17-debian AS build
WORKDIR /app
COPY pom.xml .
RUN mvn dependency:go-offline -B
COPY src ./src
RUN mvn clean package -DskipTests

# Run stage
FROM amazoncorretto:17-alpine
WORKDIR /app

# 1. Copy the ROOT CA generated by your script into the image
# (Make sure this path matches where your script outputs the file)
COPY generated/mazad-root-ca.crt /app/mazad-root-ca.crt

# 2. Add your CA to the default Java truststore
# This keeps Google/42 trust and ADDS Mazad trust
RUN keytool -importcert -noprompt \
    -alias mazad-root-ca \
    -file /app/mazad-root-ca.crt \
    -trustcacerts \
    -keystore $JAVA_HOME/lib/security/cacerts \
    -storepass changeit

# 3. Copy the AUTH-SERVICE Keystore (for the service's own HTTPS)
COPY generated/auth-service.p12 /app/keystore.p12

COPY --from=build /app/target/auth-service-*.jar app.jar

ENTRYPOINT ["java", "-jar", "app.jar"]